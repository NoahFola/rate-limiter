# =============================================================================
# Terraform
# =============================================================================
**/.terraform/
*.tfstate
*.tfstate.backup
tfplan
# terraform.tfvars contains secrets - keep local, commit a .tfvars.example instead
terraform.tfvars
*.tfvars
# Keep the lock file (reproducible provider versions)
!.terraform.lock.hcl

